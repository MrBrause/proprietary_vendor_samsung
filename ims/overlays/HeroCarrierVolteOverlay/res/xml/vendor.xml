<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
  Overrides com.android.carrierconfig R.xml.vendor. Parsed by DefaultCarrierConfigService
  and appended to the config of EVERY subscription (no MCCMNC/carrierId filter = applies to
  all). booleans use a value= attribute (unlike <string>, whose value is element text).
-->
<carrier_config_list>
    <carrier_config>
        <!-- Required by isVolteEnabledByPlatform() so the "4G Calls" toggle is shown. -->
        <boolean name="carrier_volte_available_bool" value="true" />
        <!-- Keep the toggle user-editable and visible; VoLTE on by default. -->
        <boolean name="editable_enhanced_4g_lte_bool" value="true" />
        <boolean name="hide_enhanced_4g_lte_bool" value="false" />
        <boolean name="enhanced_4g_lte_on_by_default_bool" value="true" />
        <!-- No carrier provisioning gate (engine/CSC drive actual registration). -->
        <boolean name="carrier_volte_provisioning_required_bool" value="false" />
    </carrier_config>
</carrier_config_list>
